{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/server.tsbuildinfo"
  },
  "include": ["drizzle.config.ts", "src/server", "src/shared", "tests"]
}
